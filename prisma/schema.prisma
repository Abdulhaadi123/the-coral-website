datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  category    String
  topBadge    String   @default("")
  tags        String[]
  image       String   // Small Card Thumbnail (Cloudinary URL)
  detailImages ProjectDetailImage[] // Full Page Detail View, one or more stacked slices
  videos      ProjectVideo[]
  bg          String   @default("#1a1a1a")
  featured    Boolean  @default(false)
  // When true the project is hidden from, and blocked for, visitors outside
  // Pakistan (admins always see it). Decided per project in the admin panel.
  pakistanOnly Boolean @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One or more YouTube videos attached to a portfolio project, each with its
// own title, played in an in-site lightbox gallery.
model ProjectVideo {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// One slice of a project's detail-page showcase. A designer can crop one tall
// design into several pieces and upload them here instead of one huge file —
// the detail page stacks them back to back with zero gap so it still reads as
// a single image, while each smaller file loads faster (and in parallel).
// width/height are the slice's real pixel size, captured client-side on
// upload, so the page can reserve the right box (no layout shift) and never
// distort the image.
model ProjectDetailImage {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  width     Int
  height    Int
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Categories — manageable in the admin so both a "Category" dropdown and the
// matching public filter list stay in sync. `type` separates independent
// namespaces ("portfolio" projects vs "blog" posts) sharing this one table.
model Category {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("portfolio")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, type])
}

// Social profile links shown as icons in the site footer, managed from
// /admin/social-links. `platform` picks the icon; "other" uses a generic link icon.
model SocialLink {
  id        String   @id @default(uuid())
  platform  String   // facebook | instagram | linkedin | youtube | x | tiktok | other
  label     String   @default("")
  url       String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id         String   @id @default(uuid())
  name       String
  role       String
  quote      String
  avatar     String?  // Avatar image (Cloudinary URL)
  logo       String?  // Company logo (Cloudinary URL)
  logoWidth  Int      @default(0)
  logoHeight Int      @default(0)
  rating     Int      @default(5)
  featured   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Partner {
  id        String   @id @default(uuid())
  name      String
  logo      String   // Logo image (S3 URL)
  // Intrinsic size passed to next/image. The marquee sizes logos by CSS height,
  // so these only fix the aspect ratio — 183x110 matches the original set.
  width     Int      @default(183)
  height    Int      @default(110)
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  subtitle    String   @default("")
  description String
  badge       String   @default("")
  category    String   @default("")
  image       String   // Cover image (card + hero banner)
  contentHtml String   // Rich text HTML body, authored in the admin editor
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  order       Int      @default(0)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PageSeo {
  id          String   @id @default(uuid())
  path        String   @unique // route path, e.g. "/", "/design", "/portfolio"
  label       String   // human-readable name shown in the admin list
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  // "super" sees everything and manages other users; "editor" only gets the
  // sections listed in `permissions`. Defaults to "super" so accounts that
  // existed before roles were introduced keep their full access.
  role         String   @default("super")
  permissions  String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  source    String   @default("portfolio_gate")
  createdAt DateTime @default(now())
}

// Generic key-value store for site-wide settings toggled from the admin panel.
// `key` is a stable identifier (e.g. "portfolio_geo_lock"); `value` is a string
// ("true" / "false" for booleans, raw text otherwise).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
