# ─────────────────────────────────────────────────────────────
# SUPABASE POSTGRESQL (Connection Pooling via Supavisor for Vercel)
# Get these from: Supabase Dashboard → Project Settings → Database → URI
# ─────────────────────────────────────────────────────────────

# Connection Pooling URL (used by Prisma for queries — required on Vercel serverless)
DATABASE_URL="postgresql://postgres.XXXXXXXXXXXX:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL (used by Prisma Migrate / db push — bypasses PgBouncer)
DIRECT_URL="postgresql://postgres.XXXXXXXXXXXX:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────
# CLOUDINARY
# Get these from: https://console.cloudinary.com → Dashboard
# ─────────────────────────────────────────────────────────────

CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─────────────────────────────────────────────────────────────
# ADMIN JWT SECRET (any random 32+ char string)
# Generate one with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

JWT_SECRET="change_me_to_a_random_secret_at_least_32_chars"

# ─────────────────────────────────────────────────────────────
# GOOGLE SHEETS WEBHOOK (Optional — for real-time row appending)
# Get from: Google Sheet → Extensions → Apps Script → Deploy as Web App
# ─────────────────────────────────────────────────────────────

GOOGLE_SHEET_WEBHOOK_URL=""
