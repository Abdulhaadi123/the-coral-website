# ─────────────────────────────────────────────────────────────
# SUPABASE POSTGRESQL (Connection Pooling via Supavisor for Vercel)
# Get these from: Supabase Dashboard → Project Settings → Database → URI
# ─────────────────────────────────────────────────────────────

# Connection Pooling URL (used by Prisma for queries — required on Vercel serverless)
DATABASE_URL="postgresql://postgres.XXXXXXXXXXXX:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL (used by Prisma Migrate / db push — bypasses PgBouncer)
DIRECT_URL="postgresql://postgres.XXXXXXXXXXXX:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────
# AWS S3  (portfolio images + homepage videos)
# ─────────────────────────────────────────────────────────────

# Public origin the browser loads media from.
# Either the bucket endpoint or, preferred, a CloudFront distribution in front of it.
# Leave EMPTY to serve everything from local /public (dev fallback).
NEXT_PUBLIC_ASSET_BASE_URL="https://d1234abcdefgh.cloudfront.net"

# Bucket + region (used by the admin uploader and `npm run sync:assets`)
AWS_REGION="us-east-2"
AWS_S3_BUCKET="coral-room-content"

# Optional key prefix. Set this when the bucket ALSO holds non-public content:
# every object is written under <prefix>/ and the CloudFront origin path points
# there, so nothing outside the prefix is reachable through the distribution.
# Leave empty for a bucket dedicated to site media.
AWS_S3_KEY_PREFIX="web"

# IAM user credentials with s3:PutObject / s3:DeleteObject / s3:ListBucket on the bucket.
# Omit these on AWS-hosted infra to use the instance/task role instead.
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."

# ─────────────────────────────────────────────────────────────
# CLOUDINARY  (legacy — existing DB records with res.cloudinary.com URLs keep working)
# Get these from: https://console.cloudinary.com → Dashboard
# ─────────────────────────────────────────────────────────────

CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─────────────────────────────────────────────────────────────
# SMTP — "Book a Call" contact form notifications
#
# Gmail: turn ON 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords
# Use that 16-character App Password below, NOT your Google account password.
# Paste it without spaces.
# ─────────────────────────────────────────────────────────────

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="you@gmail.com"
SMTP_PASSWORD="your16charapppassword"

# Where enquiries are delivered. Defaults to SMTP_USER when omitted.
CONTACT_TO_EMAIL="you@gmail.com"

# Envelope From. Defaults to SMTP_USER. Gmail rejects a From address that is not
# the authenticated user or one of its verified aliases.
CONTACT_FROM_EMAIL=""

# ─────────────────────────────────────────────────────────────
# ADMIN JWT SECRET (any random 32+ char string)
# Generate one with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

JWT_SECRET="change_me_to_a_random_secret_at_least_32_chars"

# ─────────────────────────────────────────────────────────────
# GOOGLE SHEETS WEBHOOK (Optional — for real-time row appending)
# Get from: Google Sheet → Extensions → Apps Script → Deploy as Web App
# ─────────────────────────────────────────────────────────────

GOOGLE_SHEET_WEBHOOK_URL=""
